# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Set to "false" once you've confirmed the live Conduit connection with
# services/test_conduit_connection.py. Keep as "true" to demo FlowSafe
# with clearly-labelled synthetic data (no credentials needed).
MOCK_MODE=true

# Conduit weather station API credentials (from hackathon organizers)
# API endpoint: https://conduit.jhubafrica.com/data.php (POST, form-encoded)
CONDUIT_API_KEY=a8bc59200e1bd2d04c8e
CONDUIT_EMAIL=mukamifaith493@gmail.com
CONDUIT_API_URL=https://conduit.jhubafrica.com/data.php

# How many days of recent data to pull for "live" trend calculations.
CONDUIT_LIVE_LOOKBACK_DAYS=2
